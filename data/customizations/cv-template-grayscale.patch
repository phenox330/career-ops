From 2c6ab86f45d4c2bafc94b9c91747092fe5b80e2c Mon Sep 17 00:00:00 2001
From: phenox330 <anthonygombert33@gmail.com>
Date: Sun, 5 Jul 2026 20:38:59 +0200
Subject: [PATCH] custom: neutral grayscale CV template (no teal/violet
 accents)

---
 templates/cv-template.html | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/templates/cv-template.html b/templates/cv-template.html
index a05e9e26..db0f6139 100644
--- a/templates/cv-template.html
+++ b/templates/cv-template.html
@@ -66,7 +66,7 @@
     font-family: var(--font-family);
     font-size: var(--font-size);
     line-height: 1.5;
-    color: #1a1a2e;
+    color: #0a0a0a;
     background: #ffffff;
     padding: 0;
     margin: 0;
@@ -91,7 +91,7 @@
     font-family: var(--font-family);
     font-size: 28px;
     font-weight: 700;
-    color: #1a1a2e;
+    color: #0a0a0a;
     letter-spacing: -0.02em;
     margin-bottom: 6px;
     line-height: 1.1;
@@ -109,9 +109,8 @@
   }
 
   .header-gradient {
-    height: 2px;
-    background: linear-gradient(to right, var(--accent-color), var(--secondary-color));
-    border-radius: 1px;
+    height: 1px;
+    background: #e5e5e5;
     margin-bottom: 10px;
   }
 
@@ -306,6 +305,7 @@
     padding: 1px 6px;
     border-radius: 2px;
     margin-left: 6px;
+    border: 1px solid #e5e5e5;
   }
 
   .project-desc {
@@ -560,7 +560,7 @@
   }
 
   html[lang="ar"] .header-gradient {
-    background: linear-gradient(to left, var(--accent-color), var(--secondary-color));
+    background: #e5e5e5;
   }
 
   html[lang="ar"] .job ul {
@@ -733,6 +733,7 @@
       <a href="tel:{{PHONE}}">{{PHONE}}</a>
       <a href="mailto:{{EMAIL}}">{{EMAIL}}</a>
       <a href="{{LINKEDIN_URL}}">{{LINKEDIN_DISPLAY}}</a>
+      <a href="{{GITHUB_URL}}">{{GITHUB_DISPLAY}}</a>
       <a href="{{PORTFOLIO_URL}}">{{PORTFOLIO_DISPLAY}}</a>
       <span>{{LOCATION}}</span>
     </div>
